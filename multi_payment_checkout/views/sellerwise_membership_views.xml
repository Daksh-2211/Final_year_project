<odoo>
    <record id="view_seller_membership_config_tree" model="ir.ui.view">
        <field name="name">seller.membership.config.tree</field>
        <field name="model">seller.membership.config</field>
        <field name="arch" type="xml">
            <list string="Seller-Wise Membership">
                <field name="seller_id"/>
                <field name="product_id"/>
            </list>
        </field>
    </record>

    <record id="view_seller_membership_config_form" model="ir.ui.view">
        <field name="name">seller.membership.config.form</field>
        <field name="model">seller.membership.config</field>
        <field name="arch" type="xml">
            <form string="Seller-Wise Membership">
                <sheet>
                    <group>
                        <field name="seller_id" options="{'no_create': True}"/>
                        <field name="product_id" options="{'no_create': True}"
                               domain="[
                               ('type', '=', 'service'),
                               ('recurring_invoice', '=', True),
                               ('marketplace_seller_id', '=', seller_id)
                           ]"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seller_membership_config" model="ir.actions.act_window">
        <field name="name">Seller-Wise Membership</field>
        <field name="res_model">seller.membership.config</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_seller_membership_config"
              name="Seller-Wise Membership"
              parent="sale_subscription.menu_sale_subscription_config"
              action="action_seller_membership_config"
              sequence="50"/>
</odoo>