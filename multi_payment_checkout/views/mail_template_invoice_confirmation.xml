<odoo>
    <data noupdate="0">
        <record id="taborcata_invoice_confirmation" model="mail.template">
            <field name="name">Taborcata: Faktúra</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="subject">Faktúra (Ref {{ object.name or 'n/a' }})</field>
            <field name="email_from">{{ (object.invoice_user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Custom Invoice confirmation email for Taborcata</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Vážený/á <t t-out="object.partner_id.name or ''">NAME</t>,<br/><br/>
                        ďakujeme za váš nákup na <a href="https://www.taborcata.sk" style="color: #875A7B; text-decoration:none;">www.taborcata.sk</a>.
                        Potvrdzujeme, že sme v poriadku prijali vašu platbu za objednané služby/tovar.<br/><br/>

                        <strong>Podrobnosti:</strong><br/>
                        Číslo objednávky: <t t-out="object.invoice_origin or ''">SALE ORDER NO.</t><br/>
                        Stav: Uhradené<br/>
                        Faktúra: Priložená v prílohe e-mailu<br/><br/>

                        <strong>Čo bude nasledovať?</strong><br/>
                        Pár dní pred začiatkom vám pošleme podrobné informácie (pokyny k nástupu).<br/><br/>

                        Ak by ste mali akékoľvek otázky, neváhajte nám napísať.<br/><br/>

                        Tešíme sa na spoločné dobrodružstvá a ďakujeme za prejavenú dôveru.<br/><br/>

                        Vaše Táborčatá
                    </p>
                </div>
            </field>
        </record>
    </data>
</odoo>