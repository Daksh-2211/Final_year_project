<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_seller_invoice_sequence_tree" model="ir.ui.view">
        <field name="name">seller.invoice.sequence.tree</field>
        <field name="model">seller.invoice.sequence</field>
        <field name="arch" type="xml">
            <list string="Seller Numbering" editable="bottom">
                <field name="seller_id" options="{'no_create': True}"/>
                <field name="seller_count" readonly="1" force_save="1"/>
            </list>
        </field>
    </record>

    <record id="view_seller_invoice_sequence_form" model="ir.ui.view">
        <field name="name">seller.invoice.sequence.form</field>
        <field name="model">seller.invoice.sequence</field>
        <field name="arch" type="xml">
            <form string="Seller Numbering">
                <sheet>
                    <group>
                        <field name="seller_id" options="{'no_create': True}"/>
                        <field name="seller_count" readonly="1" force_save="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_seller_invoice_sequence" model="ir.actions.act_window">
        <field name="name">Seller Numbering</field>
        <field name="res_model">seller.invoice.sequence</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_seller_invoice_sequence"
              name="Seller Numbering"
              parent="account.menu_finance_configuration"
              action="action_seller_invoice_sequence"
              sequence="0"/>
</odoo>
