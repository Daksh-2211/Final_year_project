<odoo>
    <record id="view_order_form_inherit_taborcata" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.taborcata</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='order_line']/list/field[@name='price_subtotal']" position="after">
                <field name="price_subtotal_vat" widget="monetary" string="Subtotal (VAT)"/>
            </xpath>
        </field>
    </record>
</odoo>