<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <record id="taborcata_sale_confirmation" model="mail.template">
            <field name="name">Taborcata: Potvrdenie objednávky (Slovak)</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Potvrdenie objednávky {{ object.name }}</field>
            <field name="email_from">{{ (object.user_id.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Custom Slovak confirmation email for Taborcata</field>
            <field name="body_html" type="html">
                <div style="font-size:13px;">
                    <p>
                        Dobrý deň
                        <t t-out="object.partner_id.name"/>,
                    </p>
                    <p>
                        týmto potvrdzujeme Vašu objednávku.
                        Číslo vašej objednávky je
                        <strong><t t-out="object.name"/></strong>.
                    </p>
                    <p t-if="object.state in ['sent', 'sale']">
                        Ak ste neplatili kartou, objednávku môžete uhradiť prevodom na účet:<br/>
                        <strong>SK57 8330 0000 0026 0290 2887</strong><br/>
                        Prosím použite variabilný symbol:
                        <strong><t t-out="object.name.replace('S','').replace('O','')"/></strong>
                    </p>
                    <p style="text-decoration: underline;">
                        Pre každý tábor vám príde samostatný e-mail potvrdzujúci objednávku 1 tábora a taktiež po úhrade aj FA samostatne.
                    </p>
                    <hr/>
                    <h3>Sumár objednávky:</h3>
                    <t t-set="event_summary" t-value="object.get_event_summary()"/>

                    <t t-if="event_summary">
                        <t t-foreach="event_summary" t-as="event">
                            <p>
                                <strong>Názov tábora:</strong>
                                <t t-out="event['event_name']"/><br/>

                                <strong>Dátum:</strong>
                                <t t-out="event['date_begin']" t-options='{"widget": "date"}'/> –
                                <t t-out="event['date_end']" t-options='{"widget": "date"}'/><br/>

                                <strong>Miesto:</strong>
                                <t t-out="event['location'] or 'Miesto nebolo určené'"/>
                            </p>
                            <t t-foreach="event['attendees']" t-as="attendee">
                                <t t-foreach="attendee['answers'].items()" t-as="ans">
                                    <p>
                                        <strong><t t-out="ans[0]"/>:</strong>
                                        <t t-out="ans[1] or '-'"/>
                                    </p>
                                </t>
                                <hr/>
                            </t>
                        </t>
                    </t>

                    <t t-if="not event_summary">
                        <p><strong>Objednané produkty:</strong></p>
                        <ul style="list-style-type: none; padding-left: 0;">
                            <t t-foreach="object.order_line" t-as="line">
                                <li style="margin-bottom: 5px;">
                                    <t t-out="line.product_id.name"/>
                                </li>
                            </t>
                        </ul>
                        <hr/>
                    </t>
                    <t t-if="object.transaction_ids and any(tx.payment_method_id.code == 'wire_transfer' for tx in object.transaction_ids)">
                        <strong>Dôležité:</strong><br/>
                        Pre správne spárovanie platby Vás prosím o uvedenie správneho variabilného symbolu a ponechanie poznámky k platbe prázdnej. Ďakujeme.<br/><br/>
                    </t>
                    <p>
                        Ak by ste mali akúkoľvek komplikáciu, volajte
                        <strong>0948 748 999</strong>.
                    </p>

                    <p>
                        Ďakujeme Vám za dôveru,<br/>
                        <strong>Tím Táborčatá</strong><br/>
                        0948 748 999 | info@taborcata.sk
                    </p>
                </div>
            </field>
            <field name="report_template_ids" eval="[(4, ref('sale.action_report_saleorder'))]"/>
        </record>
    </data>
</odoo>