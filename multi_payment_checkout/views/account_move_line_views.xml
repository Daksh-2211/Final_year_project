<odoo>

    <record id="view_move_form_inherit_readonly_name" model="ir.ui.view">
        <field name="name">account.move.form.inherit.readonly.name</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1/field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_taborcata" model="ir.ui.view">
        <field name="name">account.move.form.inherit.taborcata</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </xpath>

            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="after">
                <field name="price_subtotal_vat" widget="monetary" string="Subtotal (VAT)"/>
            </xpath>
        </field>
    </record>

    <record id="view_move_form_inherit_duplicate_control" model="ir.ui.view">
        <field name="name">account.move.form.inherit.duplicate.control</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">state != 'draft'</attribute>
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//div[hasclass('text-warning')]" position="after">
                <field name="duplicate_name_warning" invisible="1"/>
                <div class="text-danger fw-bold" invisible="not duplicate_name_warning">
                    <i class="fa fa-exclamation-triangle"/>
                    Warning: The number
                    <field name="name" readonly="1" class="oe_inline"/>
                    already exists for an Invoice or Credit Note!
                </div>
            </xpath>

        </field>
    </record>
</odoo>