<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="hidden_suggested_products" inherit_id="website_sale.suggested_products_list" name="Suggested Products">
        <xpath expr="//div[@t-foreach='suggested_products']" position="attributes">
           <attribute name="t-if">product.product_tmpl_id.id not in request.website.product_ids.ids</attribute>
        </xpath>
    </template>

    <template id="hidden_events_list" inherit_id="website_event.events_list">
        <xpath expr="//div[@t-foreach='event_ids']" position="attributes">
            <attribute name="t-if">
                event.id not in request.website.event_ids.ids
            </attribute>
        </xpath>
    </template>

</odoo>
