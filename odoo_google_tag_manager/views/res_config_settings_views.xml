<odoo>
    <data>

        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.tagmanager</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="20" />
            <field name="inherit_id" ref="website.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <setting id="cdn_setting" position="after">
                    <div class="col-xs-12 col-md-6 o_setting_box" id="google_analytics_setting">
                        <div class="o_setting_left_pane">
                            <field name="has_google_tagmanager" />
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="has_google_tagmanager" />
                            <span class="fa fa-lg fa-globe"
                                title="Values set here are website-specific."
                                groups="website.group_multi_website" />
                            <div class="text-muted">
                                Deploy and update measurement tags on your websites
                            </div>
                            <div class="content-group"
                                invisible="not has_google_tagmanager">
                                <div class="row mt16 flex">
                                    <div>
                                        <label class="col-md-3 o_light_label" string="Container ID"
                                            for="google_tagmanager_key" />
                                        <field name="google_tagmanager_key"
                                            placeholder="GTM-XXXXXXX"
                                            required="has_google_tagmanager" />
                                    </div>
                                </div>
                            </div>
                            <div invisible="not has_google_tagmanager">
                                <a href="https://support.google.com/tagmanager/answer/6103696?hl=en"
                                    class="oe_link fa fa-arrow-right" target="_blank">
                                    How to get my Google Tag Manager container ID
                                </a>
                                <a
                                    href="https://developers.google.com/analytics/devguides/collection/ga4/ecommerce?client_type=gtm"
                                    class="oe_link fa fa-arrow-right" target="_blank">
                                    How to Configure Enhanced Ecommerce Guide and create tags (GA4)
                                </a>
                            </div>

                        </div>
                    </div>
                </setting>
            </field>
        </record>

    </data>
</odoo>