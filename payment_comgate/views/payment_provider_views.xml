<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payment_provider_form_comgate" model="ir.ui.view">
        <field name="name">Comgate Provider Form</field>
        <field name="model">payment.provider</field>
        <field name="inherit_id" ref="payment.payment_provider_form"/>
        <field name="arch" type="xml">
            <group name="provider_credentials" position="inside">
                <group invisible="code != 'comgate'" name="comgate_credentials">
                    <field name="comgate_key_id" required="code == 'comgate' and state != 'disabled'" string="Key Id"/>
                    <field name="comgate_key_secret" password="True" required="code == 'comgate' and state != 'disabled'" string="Key Secret"/>
                </group>
                <group name="security" string="Security" invisible="code != 'comgate'">
                    <field name="ip_control"/>
                    <field name="http_header" invisible="ip_control != 'http_headers'" required="ip_control == 'http_headers'"/>
                </group>
            </group>
            <xpath expr="//sheet" position="before">
                <header>
                    <button class="btn btn-primary" invisible="module_state != 'installed' or code != 'comgate'" name="action_update_comgate_methods" string="Update Comgate methods" type="object"/>
                </header>
            </xpath>
        </field>
    </record>
</odoo>
