<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="view_event_form_inherit_add_partners" model="ir.ui.view">
    <field name="name">event.event.form.inherit.add.partners</field>
    <field name="model">event.event</field>
    <field name="inherit_id" ref="event.view_event_form"/>
    <field name="arch" type="xml">
        <!-- Add a new notebook page -->
        <xpath expr="//field[@name='address_id']" position="attributes">
            <attribute name="invisible">0</attribute>
        </xpath>
        <xpath expr="//notebook" position="inside">
            <page string="Venues" name="partners_page">
                <field name="address_ids"
                       options="{'no_create': True, 'no_open': False}"
                       placeholder="Add related partners">
                    <list>
                        <field name="name"/>
                        <field name="contact_address"/>
                    </list>
                </field>
            </page>
        </xpath>
    </field>
</record>
</odoo>