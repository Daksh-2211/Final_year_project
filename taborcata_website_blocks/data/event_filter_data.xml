        <record id="filter_event_b2b_kros_custom" model="ir.filters">
            <field name="name">B2B KROS Filter</field>
            <field name="model_id">event.event</field>
            <field name="domain">[('website_published', '=', True), ('b2b_partner_id', '!=', False)]</field>
            <field name="user_id" eval="False"/>
            <field name="sort">["date_begin"]</field>
        </record>

        <record id="website_snippet_filter_b2b_kros" model="website.snippet.filter">
            <field name="filter_id" ref="taborcata_website_blocks.filter_event_b2b_kros_custom"/>
            <field name="field_names">name,date_begin,date_end</field>
            <field name="limit" eval="1"/>
            <field name="name">B2B KROS Snippet Filter</field>
        </record>

