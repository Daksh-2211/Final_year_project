<?xml version="1.0" encoding="utf-8" ?>

<odoo>

    <record id="view_pohoda_export_wizard" model="ir.ui.view">
        <field name="name">pohoda.export.wizard.form</field>
        <field name="model">pohoda.export.wizard</field>
        <field name="arch" type="xml">

            <form string="Export Pohoda XML">

                <group>
                    <field name="date_from"/>
                    <field name="date_to"/>
                    <field name="seller_id"/>
                </group>

                <footer>
                    <button name="export_xml"
                            type="object"
                            string="Export XML"
                            class="btn-primary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>

        </field>
    </record>

    <record id="action_pohoda_export" model="ir.actions.act_window">
        <field name="name">Pohoda Export</field>
        <field name="res_model">pohoda.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem
            id="menu_pohoda_export"
            name="Pohoda Export"
            action="action_pohoda_export"
            parent="accountant.menu_accounting"/>

</odoo>